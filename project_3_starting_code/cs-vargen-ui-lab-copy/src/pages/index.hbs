<!--  *********** HTML for VarGen   ***********  -->
      
      <div id="varGen" class="centered-text" hidden>
        <h1>
          AI Music Variation
        </h1>
        Upload a theme <br>or<br> select a theme from our library randomly.<br>
       
<!--         <p>
          Example of how to upload an audio file to the server.
        </p> -->

        <form class="color-search" enctype="multipart/form-data">
          <div class="custom-file-upload">
            <input id ="fileUpload" type="file" name="filetoupload" accept="audio/midi, audio/x-midi"><br>
            <div class="file-upload-label-container">
              <label for="fileUpload" class="file-label">Drag and drop a MIDI file or similar to upload:</label>
              <span class="file-placeholder">No file chosen</span>
              <script>
                document.getElementById('fileUpload').addEventListener('change', function() {
                    const fileName = this.files.length > 0 ? this.files[0].name : 'No file chosen';
                    document.querySelector('.file-placeholder').textContent = fileName;
                });
              </script>
            </div>
          </div>  
        </form>
        
       

  <!--       <section id="mainVisualizer"> -->
<!--         <h2>A html-midi-player demo</h2> -->
<!--         <p>This is a demo for the <strong>html-midi-player</strong> package. For more information, see <a href="https://github.com/cifkao/html-midi-player" target="_blank">its GitHub repository</a>.</p> -->
        <div class="player general">
          <label>Preview of the Uploaded MIDI file</label>
          <midi-visualizer type="piano-roll" id="mainVisualizer" src="https://cdn.jsdelivr.net/gh/cifkao/html-midi-player@2b12128/jazz.mid"></midi-visualizer>
          <midi-player src="https://cdn.jsdelivr.net/gh/cifkao/html-midi-player@2b12128/jazz.mid" sound-font="" visualizer="#mainVisualizer" id="mainPlayer">
          </midi-player>
        </div>
        <label for="model-selector">Please choose a model:</label>
        <select id="model-selector">
            <option value="VaTr POP909">My theme genre is close to pop... (Variation Transformer trained on the POP909-TVar dataset)</option>
            <option value="VaTr VGMIDI">My theme genre is close to video game music... (Variation Transformer trained on the VGMIDI-TVar dataset)</option>
        </select>

        <p id="selected-option">You selected: None</p>
         <button id="midiButton" type="submit" onclick="myClient.midi_upload()">Generate</button>
      </div>

    <script>
        const file = document.querySelector('input[type="file"]');
        file.addEventListener('change', function() {
          const reader = new FileReader();
          reader.onload = function() {
            // const player = document.querySelector('midi-player');
            const player = document.getElementById('mainPlayer');
            player.src = reader.result;
            // const visualiser = document.querySelector('midi-visualizer');
            const visualiser = document.getElementById('mainVisualizer');
            visualiser.src = reader.result;
          };
          reader.readAsDataURL(file.files[0]);
        });
    
      </script>
      
