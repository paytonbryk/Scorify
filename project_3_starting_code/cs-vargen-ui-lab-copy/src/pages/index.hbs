<!--  *********** HTML for Login   ***********  -->
    <div class="content">

      <div id="theMainThing" class="centered-text">
        <h1>
          Sign In
        </h1>
          Login or create an account with email<br>

        <div class="input-container">
          <input id="emailAddr2" name="emailAddr" required="required" type="text">
          <label for="emailAddr2" class="input-label">Email</label>
          <script>
              const input = document.getElementById('emailAddr2');
              const label = document.querySelector('.input-label');

              input.addEventListener('focus', function() {
                  label.style.top = '5px';
                  label.style.fontSize = '12px';
                  label.style.color = 'white';
              });

              input.addEventListener('blur', function() {
                  if (!input.value) {
                      label.style.top = '65%';
                      label.style.fontSize = '16px';
                      label.style.color = '#999999';
                  }
              });
          </script>
        </div>
        <button id="emailButton" type="submit" onclick="myClient.generate_magic_link()">Submit</button>
        You will receive a link to access anything you create on this site
        <br><br><br><br><br><br><br><br><br>
      </div>
      
      
      
      <div class="Sthg"><p>Goodbye from HTML file!</p>
      
      </div>
      
<!--  *********** HTML for history selector   ***********  -->
      <div id="authSelect" class="history-select" hidden>
        <select id="mySelect">
            <option value="volvo">Volvo</option>
            <option value="saab">Saab</option>
            <option value="mercedes">Mercedes</option>
            <option value="audi">Audi</option>
        </select>
        <button id="histDownloadButton" onclick="DownloadOptions()">Download</button>
      </div>
      <div id="authMidi" hidden>
        <div class="flex-container">
          <div class="player theme" id="themePlayer">
            <label>Theme</label>
            <midi-visualizer type="piano-roll" id="authMidiVisualizerTheme" src="https://tomcollinsresearch.net/participantStudies/var24/good_examples_mp3/e0_real_Other%20games_PlayStation%202_Dark%20Cloud%202_Neverending%20Adventure_C_0.mid"></midi-visualizer>

            <midi-player src="https://tomcollinsresearch.net/participantStudies/var24/good_examples_mp3/e0_real_Other%20games_PlayStation%202_Dark%20Cloud%202_Neverending%20Adventure_C_0.mid" sound-font="" visualizer="#authMidiVisualizerTheme" id="authMidiPlayerTheme">
            </midi-player>
          </div>

          <div class="player" id="varPlayer">
            <label>Variation</label>
            <midi-visualizer type="piano-roll" id="authMidiVisualizerVar" src="https://tomcollinsresearch.net/participantStudies/var24/good_examples_mp3/e0_real_Other%20games_PlayStation%202_Dark%20Cloud%202_Neverending%20Adventure_C_0_tvAttnVar0.mid"></midi-visualizer>

            <midi-player src="https://tomcollinsresearch.net/participantStudies/var24/good_examples_mp3/e0_real_Other%20games_PlayStation%202_Dark%20Cloud%202_Neverending%20Adventure_C_0_tvAttnVar0.mid" sound-font="" visualizer="#authMidiVisualizerVar" id="authMidiPlayerVar">
            </midi-player>
          </div>
        </div>

