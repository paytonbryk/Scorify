# Copy this to .env — never commit .env to git.

# Render sets RENDER_EXTERNAL_URL automatically; override only for local dev.
PUBLIC_URL=http://localhost:3000

# Gmail app-password for magic-link emails (use a burner account).
SMTP_LOGIN=yourburner@gmail.com
SMTP_PASSW=your-gmail-app-password
TEST_SENDER=yourburner@gmail.com

# Shared secret between UI server and 2nd server.
# Set the same value in both .env files.
JOBS_SIG=choose-a-long-random-string
