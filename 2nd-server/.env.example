# Copy to .env on woodforde — never commit.

# Your Render app URL (no trailing slash).
UI_BASE_URL=https://scorify.onrender.com

# Must match JOBS_SIG in the UI server .env.
JOBS_SIG=choose-a-long-random-string

# Absolute path to your chordgnn repo clone on woodforde.
CHORDGNN_DIR=/home/YOUR_USERNAME/chordgnn

# Where job temp files are stored on woodforde.
WORK_DIR=/home/YOUR_USERNAME/scorify_jobs
