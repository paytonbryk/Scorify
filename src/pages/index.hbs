<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{seo.title}}</title>
  <meta name="description" content="{{seo.description}}">
  <link rel="stylesheet" href="/style.css">
  <!-- OpenSheetMusicDisplay -->
  <script src="https://cdn.jsdelivr.net/npm/opensheetmusicdisplay@1.8.3/build/opensheetmusicdisplay.min.js"></script>
  <!-- Tone.js -->
  <script src="/vendor/Tone.11.js"></script>
  <!-- App -->
  <script src="/client.js" defer></script>
</head>
<body>
  <header>
    <h1>Scorify</h1>
    <p class="tagline">Upload • View • Play • Analyse</p>
  </header>
  <main>

    <!-- ── Sign-in ─────────────────────────────────── -->
    <section id="authSection">
      <h2>Sign in</h2>
      <form id="emailForm">
        <label for="emailAddr">Email address</label>
        <input id="emailAddr" name="emailAddr" type="email" required placeholder="you@example.com">
        <button type="submit">Send sign-in link</button>
      </form>
      <p id="authStatus" role="status"></p>
    </section>

    <!-- ── Main app (shown after sign-in) ────────────── -->
    <section id="appSection" hidden>

      <div id="topBar">
        <span id="userLabel"></span>
        <button id="signOutBtn" type="button">Sign out</button>
      </div>

      <!-- Upload -->
      <section id="uploadSection">
        <h2>Upload MusicXML</h2>
        <input id="xmlFile" type="file" accept=".xml,.musicxml">
        <button id="uploadBtn" type="button">Upload</button>
        <p id="uploadStatus" role="status"></p>
      </section>

      <!-- My scores -->
      <section id="scoresSection">
        <h2>My scores</h2>
        <ul id="scoreList"></ul>
      </section>

      <!-- Score viewer / playback -->
      <section id="viewerSection" hidden>
        <h2 id="scoreTitle">Score</h2>
        <div id="controls">
          <button id="playBtn" type="button">▶ Play</button>
          <button id="stopBtn" type="button">■ Stop</button>
          <label class="speed-control" for="playbackSpeed">Speed
            <select id="playbackSpeed">
              <option value="0.25">0.25×</option>
              <option value="0.5">0.5×</option>
              <option value="0.75">0.75×</option>
              <option value="1" selected>1×</option>
              <option value="1.25">1.25×</option>
              <option value="1.5">1.5×</option>
              <option value="2">2×</option>
            </select>
          </label>
          <button id="analyseBtn" type="button">🔍 ChordGNN Analysis</button>
          <button id="exportAnalysisBtn" type="button" disabled>Export annotated MusicXML</button>
        </div>
        <div id="playheadBar" title="Click to seek">
          <div id="playheadFill"></div>
          <span id="playheadTime"></span>
        </div>
        <div id="scoreViewport" tabindex="0" role="region" aria-label="Scrollable sheet music">
          <div id="scoreContainer"></div>
        </div>
        <div id="analysisSection" hidden>
          <h3>Harmonic Analysis</h3>
          <div id="analysisResult"></div>
        </div>
        <p id="viewerStatus" role="status"></p>
      </section>

    </section>
  </main>
</body>
</html>
